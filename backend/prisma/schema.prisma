  STUDENT_PROFILE_UPDATE
  STUDENT_DOCUMENT_UPLOAD
  STUDENT_DOCUMENT_DELETE
  STUDENT_DOCUMENT_RESTORE

  // Internship Operations
  INTERNSHIP_CREATE
  INTERNSHIP_UPDATE
  INTERNSHIP_DELETE
  INTERNSHIP_ACTIVATE
  INTERNSHIP_DEACTIVATE
  INTERNSHIP_VIEW

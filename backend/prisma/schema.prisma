  @@index([applicationId])
  @@index([studentId])
  @@index([status])
  @@index([reportMonth, reportYear])
  @@index([dueDate])
  @@index([isDeleted])
  @@index([applicationId, status])
  @@index([studentId, status])
  @@index([status, dueDate])
  @@index([studentId, reportMonth, reportYear])
  @@index([studentId, isDeleted])
  @@index([applicationId, isDeleted])
  @@map("monthly_reports")
}

// Faculty Visit Log
